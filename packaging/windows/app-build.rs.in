// SUPERSEDED — `apps/cella/build.rs` is the file that builds, and this copy is kept only as
// the setup instructions it used to carry. Do not edit both: change `apps/cella/build.rs`.
//
// TEMPLATE for apps/cella/build.rs (copied from DesignCraft by the release-tooling setup;
// apps/cella didn't exist yet). Move it there and add to apps/cella/Cargo.toml:
//
//   [build-dependencies]
//   # Icon + VERSIONINFO for cella.exe; build.rs only uses it when the target is Windows.
//   winresource = "0.1"
//
// and to apps/cella/src/main.rs (package.ps1 checks the exe is a GUI-subsystem binary):
//
//   #![cfg_attr(all(target_os = "windows", not(debug_assertions)), windows_subsystem = "windows")]
//
// package.ps1 sets CELLA_REQUIRE_WINRES=1 so release builds fail without the resources.

//! Windows only: embed the app icon and version info (VERSIONINFO) into `cella.exe`, so it
//! shows in Explorer, the taskbar, the Start menu and Alt-Tab.
//!
//! On every other target this does nothing. A missing resource compiler is a warning, so a
//! cross-compile from macOS or Linux still links, unless `CELLA_REQUIRE_WINRES=1` turns it
//! into an error (for release builds).

fn main() {
    println!("cargo:rerun-if-changed=build.rs");
    println!("cargo:rerun-if-changed=../../assets/app-icon/cella.ico");
    println!("cargo:rerun-if-env-changed=CELLA_REQUIRE_WINRES");
    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("windows") {
        return;
    }
    let mut res = winresource::WindowsResource::new();
    res.set_icon("../../assets/app-icon/cella.ico")
        .set("ProductName", "Cella")
        .set("FileDescription", "Cella spreadsheet")
        .set("CompanyName", "Matt-qwq")
        .set("LegalCopyright", "Copyright (c) the Cella authors. MIT OR Apache-2.0.")
        .set("OriginalFilename", "cella.exe")
        .set("InternalName", "cella");
    if let Err(e) = res.compile() {
        if std::env::var_os("CELLA_REQUIRE_WINRES").is_some() {
            eprintln!("embedding Windows resources failed: {e}");
            std::process::exit(1);
        }
        println!("cargo:warning=cella.exe built without icon/version resources: {e}");
    }
}
